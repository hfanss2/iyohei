include _partial/helpers.pug

if page.title
  - var current_title = page.title
else
  - var current_title = config.title

if config.feed
  case config.feed.type
    when 'rss2'
      - var feed_type='application/rss+xml'
    when 'atom'
    default
      - var feed_type='application/atom+xml'

doctype html
html(lang=config.language)

  include _partial/head.pug

  body
  div(id='header-02',style='background-color:#f5f5f5;',class="fixedNav2")
    div(style='max-width:1150px;text-align: center;margin:0 auto;')
      div(style='max-width:1150px;display:flex;',class="footer-div-a")
        div(style="text-align: left;")
          div(href=url_for('.'),class="footer-div-b",style="font-size:20px;width: 100px;padding-top:5px;font-weight:bold;")= config.title
        .nav2#nav1(class="footer-div-b")
          - for (var i in theme.menu)
            +a_with_current(theme.menu[i].directory, __(theme.menu[i].page), theme.menu[i].icon)
  .body_container
    #layout.pure-g
      .pure-u-1.pure-u-md-3-4: .content_container
        block content
      if theme.widgets_on_small_screens
        .pure-u-1.pure-u-md-1-4: #sidebar
          each item in theme.widgets
            != partial('_widget/' + item + '.pug', null, {cache: !config.relative_link})
      else
        .pure-u-1-4.hidden_mid_and_down: #sidebar
          each item in theme.widgets
            != partial('_widget/' + item + '.pug', null, {cache: !config.relative_link})
  #footer-000
    div(id='footer-02',style='text-align:center;margin:auto;font-size:14px;background-color:#f5f5f5;border-top:1px solid #ddd;')
        != partial('_partial/footer-02.pug')
    div(id='footer-01',style='text-align:center;margin:auto;font-size:14px;background-color:#DCDCDC;')
        != partial('_partial/footer.pug')
        include _partial/totop.pug
        include _partial/after_footer.pug
script(type='text/javascript', src=url_for(theme.js) + '/zidingyi.js', async)