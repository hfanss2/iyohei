.widget
  .widget-title
      a(href="#qitazujian",onclick="setShow2('fanwengzhe');") 访问者信息&nbsp;&nbsp;&nbsp;
      ||
      a(href="#zdtongji",onclick="setShow2('zdtongji');") &nbsp;&nbsp;&nbsp;站点统计
  .tagcloud
      div(id='fanwengzhe',style="display:block;heigth:200px;") 
        a(href='/archives/') 工具：<span id="gonju-xxx">未知</span><br>
        a(href='/archives/') 系统：<span id="xitong-xxx">未知</span><br>
        a(href='/archives/') 地区：<span id="diqu-xxx"></span><br>
        a(href='/site/') I P&emsp;：<span id="ip-xxx"></span>
      div(id='zdtongji',style="display:none;heigth:200px;")
        a(href='/archives/')='文章总数：'+site.posts.length
        <br>
        a(href='/archives/')='分类总数：'+site.categories.length
        <br>
        a(href='/archives/')='标签总数：'+site.tags.length
        <br>
        a(href='/site/') 网站运行时间：<span id='timeDate-a'></span>
script.
    function setShow2(id)
    {
      if(id=='fanwengzhe'){
        $('#zdtongji').attr("style","display:none");
        $('#fanwengzhe').attr("style","display:block");
      }
      if(id=='zdtongji'){
        $('#fanwengzhe').attr("style","display:none");
        var timeDate = $("#timeDate").text().replace(/[^0-9]/ig,"");$("#timeDate-a").html(timeDate+"天");
        $('#zdtongji').attr("style","display:block");
      }
    }