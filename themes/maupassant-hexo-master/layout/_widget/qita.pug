.widget
  .widget-title#qitazujian
      a(href="#qitazujian",onclick="setShow('lianxiMe');") 联系我&nbsp;&nbsp;&nbsp;
      ||
      a(href="#qitazujian",onclick="setShow('gzHao');") &nbsp;&nbsp;&nbsp;公众号&nbsp;&nbsp;&nbsp;
  .tagcloud
      div(id='lianxiMe',style="display:block;heigth:200px;") <br>
         a(href=theme.weiXinPngUrl)
           <img name="qitazujian-img" class="nofancybox" src="../img/weixinPng.png" style="width:30px;heigth:30px;background-color:#9BCD9B;border-radius:20%;padding: 5px 5px;"/>
         a(href=theme.qqPngUrl,target="_blank")
           <img name="qitazujian-img" class="nofancybox" src="../img/qqPng.png" style="width:30px;heigth:30px;background-color:#15a7f0;border-radius:20%;padding: 5px 5px;"/>
         a(href=theme.weiboPngUrl,target="_blank")
           <img name="qitazujian-img" class="nofancybox" src="../img/weiboPng.png" style="width:30px;heigth:30px;background-color:#f96774;border-radius:20%;padding: 5px 5px;"/>
         a(href=theme.githubPngUrl,target="_blank")
           <img name="qitazujian-img" class="nofancybox" src="../img/githubPng.png" style="width:30px;heigth:30px;background-color:#999;border-radius:20%;padding: 5px 5px;"/>
         a(href=theme.eMailPngUrl,target="_blank")
           <img name="qitazujian-img" class="nofancybox" src="../img/eMailPng.png" style="width:30px;heigth:30px;background-color:#00CED1;border-radius:20%;padding: 5px 5px;"/>
      div(id='gzHao',href=theme.weiXinGZHUrl,style="display:none;")
        img(width='60%',heigth='50%',src=theme.weiXinGZHUrl)
script.
    function setShow(id)
    {
      if(id=='lianxiMe'){
        $('#gzHao').attr("style","display:none");
        $('#lianxiMe').attr("style","display:block");
      }
      if(id=='gzHao'){
        $('#lianxiMe').attr("style","display:none");
        $('#gzHao').attr("style","display:block;text-align: center;");
      }
    }